# ── Google OAuth (server + client) ───────────────────────────────────────────
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
NEXT_PUBLIC_GOOGLE_ACCESS_API=https://www.googleapis.com/oauth2/v3/userinfo

# Must match satellite GOOGLE_OAUTH_REDIRECT_URL_GOOGLE_BACKUP
# Local: http://localhost:10002
# Production: https://your-satellite-domain.com (no trailing slash)
NEXT_PUBLIC_GOOGLE_OAUTH_REDIRECT=http://localhost:10002

# ── API proxy (browser → Next.js → satellite) ────────────────────────────────
# Keep /api/proxy/ in production — Next rewrites to BACKEND_API_URL
NEXT_PUBLIC_BACKEND_URL=/api/proxy/

# Satellite console API root (server-side rewrite target)
# Same machine: http://127.0.0.1:10002/api/v0
# Remote satellite: https://your-satellite-domain.com/api/v0
BACKEND_API_URL=http://localhost:10002/api/v0

# ── Firebase Cloud Messaging (optional) ─────────────────────────────────────
NEXT_PUBLIC_FIREBASE_CONFIG={"apiKey":"YOUR_API_KEY","authDomain":"YOUR_PROJECT.firebaseapp.com","projectId":"YOUR_PROJECT","storageBucket":"YOUR_PROJECT.firebasestorage.app","messagingSenderId":"YOUR_SENDER_ID","appId":"YOUR_APP_ID","vapidKey":"YOUR_VAPID_KEY"}

# ── Runtime (PM2 / Docker) ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── ReCaptcha site key ──────────────────────────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_SITE_KEY

